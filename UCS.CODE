from queue import PriorityQueue

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('F', 3)],
    'D': [],
    'E': [('F', 1)],
    'F': []
}

def ucs(start, goal):
    pq = PriorityQueue()
    pq.put((0, start))
    visited = set()

    while not pq.empty():
        cost, node = pq.get()

        if node in visited:
            continue

        visited.add(node)
        print(node, "Cost:", cost)

        if node == goal:
            print("Goal Reached")
            return

        for neighbor, weight in graph[node]:
            if neighbor not in visited:
                pq.put((cost + weight, neighbor))

ucs('A', 'F')
