from queue import PriorityQueue

graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

heuristic = {
    'A': 6,
    'B': 4,
    'C': 2,
    'D': 5,
    'E': 3,
    'F': 0
}

def greedy(start, goal):
    pq = PriorityQueue()
    pq.put((heuristic[start], start))
    visited = set()

    while not pq.empty():
        h, node = pq.get()

        if node in visited:
            continue

        print(node)
        visited.add(node)

        if node == goal:
            print("Goal Reached")
            return

        for neighbor in graph[node]:
            if neighbor not in visited:
                pq.put((heuristic[neighbor], neighbor))

greedy('A', 'F')
